{
  "name": "canada-postal-delivery-map",
  "private": true,
  "version": "1.0.0",
  "description": "加拿大快递邮编展示系统 - 基于Statistics Canada官方FSA边界数据的可视化展示应用",
  "author": "Canada Postal Delivery System",
  "homepage": "./",
  "scripts": {
    "dev": "vite --port 5001",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "dev:backend": "cd backend && npm run dev",
    "build": "vite build",
    "build:all": "npm run build && cd backend && npm run build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "./start.sh",
    "start:win": "start.bat",
    "setup": "npm run setup:deps && npm run setup:db",
    "setup:deps": "npm install && cd backend && npm install && cd ..",
    "setup:db": "cd backend && npx prisma migrate dev --name init && npx prisma generate && cd ..",
    "clean": "rm -rf node_modules dist backend/node_modules",
    "clean:win": "if exist node_modules rmdir /s /q node_modules && if exist dist rmdir /s /q dist && if exist backend\node_modules rmdir /s /q backend\node_modules",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^10.16.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "proj4": "^2.19.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.8.2",
    "react-window": "^2.1.0",
    "shapefile": "^0.6.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "vite": "^5.0.8",
    "wait-on": "^8.0.3"
  }
}
