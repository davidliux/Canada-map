# Database Configuration (Required for Vercel)
# 在 Vercel 上使用 Vercel Postgres 或其他数据库服务
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Environment
NODE_ENV=production

# CORS Configuration
# 多个域名用逗号分隔
CORS_ORIGIN=https://your-app.vercel.app,https://your-custom-domain.com

# JWT Configuration (Optional - for authentication)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_PORT=5050
API_PREFIX=/api/v1

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://default:password@host:port

# Logging Level
LOG_LEVEL=info

# Vercel Specific (These are automatically set by Vercel)
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=your-deployment-url.vercel.app
# VERCEL_REGION=iad1
