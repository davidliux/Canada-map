# Node Environment
NODE_ENV=development
PORT=5050

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/canada_postal_db?schema=public"

# Redis Configuration (Optional)
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5001,http://localhost:5173

# Logging
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@canadapostal.com

# Frontend URL (for email links, etc.)
FRONTEND_URL=http://localhost:5001

# Admin Default User
ADMIN_EMAIL=admin@canadapostal.com
ADMIN_PASSWORD=Admin123!@#